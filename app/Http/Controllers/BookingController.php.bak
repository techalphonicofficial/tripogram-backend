    $packageCode = strtoupper(preg_replace('/[^A-Za-z0-9]/', '', $package->package_code ?? 'PKG'));

    $dateCode = Carbon::now()->format('my'); // 0426, 0526
    $prefix = "ETIN{$stateCode}{$packageCode}-{$dateCode}";

